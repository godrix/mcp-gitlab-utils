{
  "name": "@godrix/mcp-gitlab-utils",
  "version": "0.3.2",
  "description": "MCP server for GitLab: pipelines, MRs, review context, and worktrees",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "mcp-gitlab-utils": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "pack:mcpb": "npm run build && npx --yes @anthropic-ai/mcpb pack",
    "pack:mcpb:slim": "npm run build && rm -rf node_modules && npm ci --omit=dev --ignore-scripts && npx --yes @anthropic-ai/mcpb pack"
  },
  "keywords": [
    "mcp",
    "gitlab",
    "merge-request",
    "ci-cd",
    "model-context-protocol"
  ],
  "author": "Godrix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/godrix/mcp-gitlab-utils.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
